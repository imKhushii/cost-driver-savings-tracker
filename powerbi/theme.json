{
  "name": "Cost Driver - Enterprise",
  "dataColors": [
    "#1F4E79",
    "#2E75B6",
    "#ED7D31",
    "#107C41",
    "#C00000",
    "#7030A0",
    "#404040",
    "#A6A6A6"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F4E79",
  "good": "#107C41",
  "neutral": "#ED7D31",
  "bad": "#C00000",
  "maximum": "#1F4E79",
  "center": "#ED7D31",
  "minimum": "#C00000",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1F2933"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F4E79"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#3E4C59"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1F4E79"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 6 }],
        "dropShadow": [{ "show": true, "preset": "Soft", "color": { "solid": { "color": "#D3D8DE" } } }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left" }]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          { "increaseFill": { "solid": { "color": "#C00000" } } },
          { "decreaseFill": { "solid": { "color": "#107C41" } } },
          { "totalFill": { "solid": { "color": "#1F4E79" } } }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F4E79" } }, "fontSize": 28, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#3E4C59" } }, "fontSize": 10 }]
      }
    }
  }
}
